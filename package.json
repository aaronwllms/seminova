{
  "name": "seminova",
  "description": "An opinionated, AI-native starter for building SaaS products with Next.js and Supabase.",
  "version": "1.0.0",
  "private": true,
  "author": "Michael Troya <hi@michaeltroya.ca> (@michaeltroya)",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "seminova",
    "supabase",
    "tailwindcss",
    "shadcn",
    "typescript",
    "saas-starter"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/checks/supabase-env.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "type-check": "tsc --pretty --noEmit",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:file": "node scripts/checks/vitest-file.mjs",
    "test:ci": "vitest run --coverage",
    "check:pnpm-only": "node scripts/checks/pnpm-only.mjs",
    "check:no-shadcn-pkg": "eslint --max-warnings 0 --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,tsx}\"",
    "check:semantic-tokens": "eslint --max-warnings 0 --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx}\"",
    "check:auth-boundary": "vitest run src/supabase/proxy.unit.test.ts",
    "check:admin-gate": "node scripts/checks/no-profiles-role.mjs && vitest run src/utils/admin.unit.test.ts",
    "check:seo-base-url": "node scripts/checks/seo-base-url.mjs",
    "check:a11y-structure": "node scripts/checks/a11y-structure.mjs",
    "check:a11y-contrast": "node scripts/checks/a11y-contrast.mjs",
    "pre-push": "pnpm type-check && pnpm check:pnpm-only && pnpm check:no-shadcn-pkg && pnpm check:semantic-tokens && pnpm check:admin-gate && pnpm check:seo-base-url && pnpm check:a11y-structure && pnpm check:a11y-contrast && pnpm lint && pnpm format-check && pnpm test:ci",
    "test:ui": "vitest --ui",
    "analyze": "ANALYZE=true pnpm build",
    "promote-admin": "node --env-file=.env.local --import tsx scripts/admin/promote-admin.ts",
    "demote-admin": "node --env-file=.env.local --import tsx scripts/admin/demote-admin.ts",
    "list-admins": "node --env-file=.env.local --import tsx scripts/admin/list-admins.ts",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/types/database.types.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "radix-ui": "^1.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-fast-marquee": "^1.6.5",
    "react-hook-form": "^7.80.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/env": "^16.2.10",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/eslint-plugin": "^1.6.21",
    "@vitest/ui": "^3.2.6",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.14.5",
    "postcss": "8.5.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "supabase": "^2.107.0",
    "tailwindcss": "4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}
